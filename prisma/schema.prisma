generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Order {
  id          Int      @id @default(autoincrement())
  kworkId     String   @unique
  title       String
  url         String
  description String?
  budget      String?
  category    String?
  publishedAt DateTime?
  discoveredAt DateTime @default(now())
  isRelevant  Boolean?
  aiReason    String?
  draftReply  String?

    // Рекомендации ИИ для заполнения формы отклика.
  suggestedBudget String?
  estimatedDays   Int?

  // Данные об отклике, который пользователь подтвердил как отправленный.
  appliedAt       DateTime?
  appliedDraft    String?
  
  notifiedAt  DateTime?
  isSkipped   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}